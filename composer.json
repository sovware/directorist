{
    "name": "wpwax/directorist",
    "authors": [
        {
            "name": "wpWax",
            "email": "support@wpWax.com"
        }
    ],
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7.0",
		"squizlabs/php_codesniffer": "^3.13",
		"wp-coding-standards/wpcs": "~2.3.0",
		"phpcompatibility/phpcompatibility-wp": "~2.1.3",
		"bamarni/composer-bin-plugin": "1.8.2",
		"wpmvc/artisan": "1.1.1"
    },
	"autoload": {
		"psr-4": {
			"App\\": "./../app/"
		}
	},
    "config": {
		"vendor-dir": "vendor-src",
		"allow-plugins": {
			"bamarni/composer-bin-plugin": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
		"setup": [
			"composer install --no-cache",
			"composer humbug/php-scoper",
			"composer add-prefix",
			"composer permission"
		],
		"add-prefix": [
			"vendor-src/bin/php-scoper add-prefix --config=dev-tools/scoper/index.php --output-dir vendor --force",
			"composer dump-autoload -d vendor"
		],
		"humbug/php-scoper": "composer bin php-scoper require --dev humbug/php-scoper:0.17.5",
		"phpcs": "vendor/vendor-src/bin/phpcs --standard=phpcs.xml",
		"format": "vendor/vendor-src/bin/phpcbf --standard=phpcs.xml",
		"sniffer:php8.1": "vendor/vendor-src/bin/phpcs -p . --standard=PHPCompatibilityWP --severity=1 --runtime-set testVersion 8.1- --extensions=php",
		"permission": [
			"chmod +x vendor/vendor-src/bin/phpcs",
			"chmod +x vendor/vendor-src/bin/phpcbf"
		]
	},
	"require": {
		"wpmvc/framework": "1.2.0"
	},
	"extra": {
		"bamarni-bin": {
			"target-directory": "vendor-src/vendor-bin"
		}
	}
}
